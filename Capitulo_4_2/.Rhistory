columns = c("Workers", "Rentiers", "Firms", "Banks", "Sum"),
codes = c("w", "r","f", "b", "s"),
c("Capital Goods", f = "+K", s ="+K"),
c("Deposits", w = "+Dw", r = "+Dr", b = "-D"),
c("Loans", w = "-Lw", b = "+Lw"),
c("Equities", r = "+E", f = "-E"),
c("Net Worth", w = "Vw", r = "Vr", f = "+K-E", b = "Lw - D",s ="+K")
)
