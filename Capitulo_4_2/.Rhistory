gamma_v = 0.009
#SENSIBILIDADE DO CONSUMO AUTÔNOMO À TAXA DE JUROS: Definido pelo autor.
phi1_v = 0.08
#PROPORÇÃO DE AMORTIZAÇÃO DO TIPO B: Calculado pelo autor a partir dos dados de 2013, com dados do BCB.
r_b_v = 0.0358
#PROPORÇÃO DE AMORTIZAÇÃO DO TIPO Z: Calculado pelo autor a partir dos dados de 2013, com dados do BCB.
r_z_v = 0.0125
#COEFICIENTE DE RELAÇÃO COM TAXA BÁSICA (I) DO TIPO B: Definido pelo autor.
lambda_b_v = 2
#COEFICIENTE DE RELAÇÃO COM TAXA BÁSICA (I) DO TIPO Z: Definido pelo autor.
lambda_z_v = 1
####2º: ESTIMAR VALORES INICIAIS A PARTIR DAS EQUAÇÕES ####
K_v = 100000
h_v = 0.2573517
Dw_v = 0
Dr_v = 0
D_v = 0
gZ_v = phi0_v - phi1_v*i_v
Yfc_v = K_v/v_v
Y_v = Yfc_v*u_v
Zw_v = Y_v*gZ_v
W_v = w_v*Y_v
Lbw_v = beta_v*W_v
Lzw_v = 1.428251282*Lbw_v
# Lbw_v = 0.047*W_v
# Lzw_v = 0.67*W_v
Lw_v = Lzw_v + Lbw_v
FT_v = pi_v*Y_v
FD_v = ro_v*FT_v
Fb_v = i_v*Lw_v
Cr_v = cr_v*(FD_v + Fb_v)
Ydw_v = W_v - (r_b_v+i_v*lambda_b_v)*Lbw_v - (r_z_v+i_v*lambda_z_v)*Lzw_v
Ciw_v = cw_v * Ydw_v
Bw_v = r_b_v*Lbw_v + beta_v*W_v*gZ_v
Cw_v = Ciw_v + Bw_v  + Zw_v
FU_v = 0
I_v = h_v*Y_v -delta_v*K_v
E_v = I_v
Ydr_v = FD_v + Fb_v
C_v = Cw_v + Cr_v
Ycalc_v = Cw_v + Cr_v + I_v
SAVw_v = Ydw_v - Cw_v
SAVr_v = FD_v + Fb_v - Cr_v
SAV_v = SAVw_v + SAVr_v + FU_v
Vr_v = SAVr_v + E_v
####3º: VALORES INICIAIS E sfcr_set####
#####DEFINIÇÃO: VALORES INICIAIS####
parametros_iniciais <- list(
W = W_v,
Yfc = Yfc_v,
Ciw = Ciw_v,
Bw = Bw_v,
Zw = Zw_v,
Cw = Cw_v,
Cr = Cr_v,
C = C_v,
E = E_v,
# Vr = Vr_v,
u = u_v,
h = h_v,
# Dw = Dw_v,
# Dr = Dr_v,
# D = D_v,
Lbw = Lbw_v,
Lzw = Lzw_v,
Lw = Lbw_v+Lzw_v,
Y = Ycalc_v,
Ydr = Ydr_v,
Ydw = Ydw_v,
SAVw = SAVw_v,
SAVr = SAVr_v,
SAV = SAV_v,
Fb = Fb_v,
FT = FT_v,
FU = FU_v,
FD = FD_v,
K = K_v,
I = h_v*Y_v,
gZ = gZ_v
)
# Transforma em lista de fórmulas
lista_formula_iniciais <- lapply(names(parametros_iniciais), function(nome) {
as.formula(paste0(nome, " ~ ", parametros_iniciais[[nome]]))
})
#####sfcr_set####
# Chama sfcr_set via do.call
init <- do.call(sfcr_set, lista_formula_iniciais)
#####DEFINIÇÃO: VALORES EXTERNOS####
# Lista nomeada de parâmetros
parametros_externos <- list(
pi = pi_v,
w = w_v,
cw = cw_v,
cr = cr_v,
ro = ro_v,
un = un_v,
v = v_v,
delta = delta_v,
i = i_v,
r_b = r_b_v,
r_z = r_z_v,
lambda_b = lambda_b_v,
lambda_z = lambda_z_v,
gamma = gamma_v,
phi0 = phi0_v,
phi1 = phi1_v,
beta = beta_v
)
# Transforma em lista de fórmulas
lista_formula_externos <- lapply(names(parametros_externos), function(nome) {
as.formula(paste0(nome, " ~ ", parametros_externos[[nome]]))
})
#####sfcr_set####
# Chama sfcr_set via do.call
ext <- do.call(sfcr_set, lista_formula_externos)
####4º: CENÁRIO BASE####
print(nome_modelo)
sim_model <- sfcr_baseline(
equations = selected_equations,
external  = ext,
initial   = init,
periods   = period_simulation
)
df_simulation <- sim_model |>
mutate(
modelo = nome_modelo
)
return(df_simulation
# sim_model = sim_model
)
}
lista_modelos_baseline <- purrr::pmap(grid_base_models, sfcr_scenarios)
names(lista_modelos_baseline) <- grid_base_models$nome_modelo
period_simulation <- 1000
####função para adicionar variáveis de análise nos modelos simulados
process_model_df <- function(df_model) {
df_model |>
mutate(
#serviço da dívida
#serviço consumo induzido
dsbw_y = ((r_b+i*lambda_b)*Lbw)/(w*Y),
#serviço consumo autônomo
dszw_y = ((r_z+i*lambda_z)*Lzw)/(w*Y),
#serviço total
dsw_y = dsbw_y + dszw_y,
#consumo em relação ao estoque de capital
cw_k= Cw/lag(K),
cr_k= Cr/lag(K),
#consumo em relação à renda
cw_y= Cw/Y,
cr_y= Cr/Y,
bw_y = Bw/Y,
zw_y = Zw/Y,
#nível de consumo
log_Cw = log(Cw),
#dívida em relação aos salários
lbw= Lbw/W,
lzw= Lzw/W,
lw= Lw/W,
#nível da renda
log_y = log(Y),
log_ydw = log(Ydw),
gY = Y/lag(Y) -1,
#patrimônio Líquido
Vw_y = Vw/Y,
Vr_y = Vr/Y,
rel_l = Lbw/Lzw,
# SAVr_Y = SAVr/Y,
Zw_L = Zw/Lw,
# Zw líquido
ZZw = Zw -(((r_b+i*lambda_b)*Lbw) + ((r_z+i*lambda_z)*Lzw)),
gZZw = ZZw/lag(ZZw)-1,
gW = W/lag(W)-1,
dif_g = gW-gZZw
# gCa = Ca/lag(Ca)-1,
#estabilidade keynesiana
# est_key = if ( (1- cr_v*ro_v*pi_v -cw_v*(1-beta_v)*w_v) > h_v) {1} else {0}
)|>
pivot_longer(cols = -any_of(c("period", "modelo")))
}
# var <- "u"
# idx <- "1"
gerar_subplot <- function(vars) {
df_scenario1_filtered <- df_scenario1_TOTAL %>%
filter(name %in% vars) |>
filter(period <= 600)
# Número de colunas
ncols <- length(vars)
nrows <- ceiling(length(vars) / ncols)
plots_scenario1 <- map2(vars, seq_along(vars), function(var, idx) {
df_var <- df_scenario1_filtered %>% filter(name == var)
show_legend <- idx == 1  # só mostra a legenda no primeiro subplot
plot_ly() %>%
add_trace(
data = df_var %>% filter(CHOQUE == list_CHOQUE[1]),
x = ~period,
y = ~value,
type = 'scatter',
mode = 'lines',
line = list(dash = "solid", width = 2),
name = list_CHOQUE[1],
legendgroup = list_CHOQUE[1],
showlegend = show_legend,
color = I("black")
) %>%
add_trace(
data = df_var %>% filter(CHOQUE == list_CHOQUE[2]),
x = ~period,
y = ~value,
type = 'scatter',
mode = 'lines',
line = list(dash = "dot", width = 2),
name = list_CHOQUE[2],
legendgroup = list_CHOQUE[2],
showlegend = show_legend,
color = I("#FC8D62")
) %>%
layout(
title = list(text = var, font = list(size = 10)),
xaxis = list(title = ""),
yaxis = list(title = "")
# yaxis = list(dtick = 0.001)
# yaxis = list(range = yaxis_range)
)
})
# Combina os subplots
p_model__scenario1 <- subplot(
plots_scenario1,
nrows = nrows,
shareX = TRUE,
shareY = FALSE,
titleX = TRUE,
titleY = TRUE,
margin = 0.05
) %>%
layout(
legend = list(orientation = "h",
x = 0.5, xanchor = "center",
y = -0.3,
font = list(size = 18)  # << tamanho da fonte da legenda
),
margin = list(t = 70,
b = 0),
# Aumenta fonte dos eixos
xaxis = list(titlefont = list(size = 18), tickfont = list(size = 16)),
xaxis2 = list(titlefont = list(size = 18), tickfont = list(size = 16)),
xaxis3 = list(titlefont = list(size = 18), tickfont = list(size = 16)),
yaxis = list(titlefont = list(size = 18), tickfont = list(size = 16)),
yaxis2 = list(titlefont = list(size = 18), tickfont = list(size = 16)),
yaxis3 = list(titlefont = list(size = 18), tickfont = list(size = 16))
)
# Criar as annotations (como título das subplots)
annotations <- map2(
seq_along(vars),
vars,
~list(
x = ((.x - 1) %% ncols) / ncols + 1 / (2 * ncols),
y = 1 - floor((.x - 1) / ncols) / nrows +0.1,
text = .y,
xref = "paper", yref = "paper",
showarrow = FALSE,
font = list(size = 20)
)
)
# Adicionar títulos às subplots
p_model__scenario1 %>%
layout(
title = "",
annotations = annotations,
template = "plotly_white"
)
}
gerar_subplot_ggplot <- function(vars) {
df_plot <- df_scenario1_TOTAL %>%
dplyr::filter(name %in% vars, period <= 600)
df_plot$CHOQUE <- factor(df_plot$CHOQUE, levels = list_CHOQUE)
df_plot$name <- factor(df_plot$name, levels = vars)
ggplot(df_plot, aes(x = period, y = value)) +
geom_line(
aes(
linetype = CHOQUE,
color = CHOQUE
),
linewidth = 1
) +
labs(
x = "Horizonte",
y = ""
) +
theme_bw(base_size = 16) + # Tema de fundo branco
theme(
text = element_text(size = 18),       # aumenta todas as fontes
axis.title = element_text(size = 18), # títulos dos eixos
axis.text = element_text(size = 16),  # valores dos eixos
legend.text = element_text(size = 20),
panel.grid.minor = element_blank(),                    # remove grades menores
panel.grid.major.x = element_line(color = "grey90"),   # mantém apenas a grade principal em x
panel.grid.major.y = element_line(color = "grey90"),
panel.background = element_rect(fill = "white", color = "white"),  # Fundo branco no painel
plot.background = element_rect(fill = "white", color = "white"),  # Fundo branco no gráfico
legend.position = "bottom",
legend.title = element_blank())+
facet_wrap(~ name, scales = "free_y") +
scale_linetype_manual(
values = setNames(
c("solid", "dashed"),
list_CHOQUE
)
) +
scale_color_manual(
values = setNames(
c("green4", "orange3"),
list_CHOQUE
)
)+
theme(strip.text = element_text(size = 12))
}
#função para salvar os subplots
salvar_subplot <- function(vars, filename) {
#plots ggplot
plot_ggplot <- gerar_subplot_ggplot(vars)
ggsave(filename = file.path("Output", paste0(filename, "_ggplot.png")), plot = plot_ggplot,
width = 12, height = 4, dpi = 800 )
ggsave(filename = file.path("Output", paste0(filename, ".svg")), plot = plot_ggplot,
width = 12, height = 4, dpi = 800 )
