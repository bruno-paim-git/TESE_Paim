source("./01_tese_equations.R")
source("./02_tese_auxiliary_functions.R")
}
####SHOCKS####
period_simulation <- 1000
base_model <- lista_modelos_baseline[["BETA03_PHI06"]]
####Choque em i####
shock_fix <- sfcr_shock(
variables = sfcr_set(
i ~ 0.04,
),
start = 50,
end = period_simulation
)
list_CHOQUE <- c(0.05, 0.06) #CHOQUE i
shock_exp <- sfcr_expand(shock_fix, i, list_CHOQUE)
tese_shock <- sfcr_multis(shock_exp, base_model, periods = 1000, method = "Newton")
names(tese_shock) <- list_CHOQUE
df_scenario1_TOTAL <- map_df(tese_shock, process_model_df, .id = "CHOQUE")
var_shock <- "01_shock_i_"
horizon_periods = 500
gerar_subplot_ggplot(c("u", "h","dsb_y", "dsz_y", "ds_y","cw_y", "cr_y", "lb_w", "lz_w", "l_w", "ciw_y", "bw_y", "zw_y", "lb_y", "lz_y", "l_y", "icc_z", "icc_b"), periods = horizon_periods)
salvar_subplot(c("dsb_w", "dsz_w", "ds_w"), filename =  paste0(var_shock,"C"), periods = horizon_periods)
####Choque em i####
shock_fix <- sfcr_shock(
variables = sfcr_set(
i ~ 0.04,
),
start = 50,
end = period_simulation
)
list_CHOQUE <- c(0.05, 0.06) #CHOQUE i
shock_exp <- sfcr_expand(shock_fix, i, list_CHOQUE)
tese_shock <- sfcr_multis(shock_exp, base_model, periods = 1000, method = "Newton")
names(tese_shock) <- list_CHOQUE
df_scenario1_TOTAL <- map_df(tese_shock, process_model_df, .id = "CHOQUE")
var_shock <- "01_shock_i_"
horizon_periods = 500
####função para adicionar variáveis de análise nos modelos simulados
process_model_df <- function(df_model) {
df_model |>
# teste <-  df_model |>
mutate(
#serviço da dívida
#serviço consumo induzido
dsb_y = ((r_b+icc_b)*lag(Lb))/(Y),
#serviço consumo autônomo
dsz_y = ((r_z+icc_z)*lag(Lz))/(Y),
#serviço total
ds_y = dsb_y + dsz_y,
dsb_w = ((r_b+icc_b)*lag(Lb))/(W),
#serviço consumo autônomo
dsz_w = ((r_z+icc_z)*lag(Lz))/(W),
#serviço total
ds_w = dsb_w + dsz_w,
#consumo em relação ao estoque de capital
cw_k= Cw/lag(K),
cr_k= Cr/lag(K),
#consumo em relação à renda
cw_y= Cw/Y,
cr_y= Cr/Y,
cw_yw= Cw/W,
cr_yr= Cr/Ydr,
ciw_y = Ciw/Y,
c_y = C/Y,
bw_y = Bw/Y,
zw_y = Zw/Y,
zw_c = Zw/Cw,
bw_c = Bw/Cw,
ciw_c = Ciw/Cw,
#nível de consumo
log_Cw = log(Cw),
log_Zw = log(Zw),
log_Bw = log(Bw),
log_Ciw = log(Ciw),
log_Cr = log(Cr),
#dívida em relação aos salários
lb_w = Lb/W,
