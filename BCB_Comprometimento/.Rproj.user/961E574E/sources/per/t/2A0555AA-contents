# faz download da série de Dados Abertos sobre as Estatísticas de Meio de Pagamento do BC
url_base <- "https://olinda.bcb.gov.br/olinda/servico/MPV_DadosAbertos/versao/v1/odata/INTERCAMDA(trimestre=@trimestre)?@trimestre='"
Ano <- 2001
Mes <- 1
url_teste <- paste0(url_base,
                    Ano,
                    Mes,
                    "'&$format=text/csv&$select=trimestre,funcaoCartao,segmento,numeroparcelas,valorTransacoes,qtdTransacoes")

base_cartao <- read.csv(url_teste)

df_cartoes <- base_cartao |>
  group_by(trimestre, funcaoCartao, segmento, numeroparcelas) |>
  mutate(
    valorTransacoes = as.numeric(gsub(",", ".", valorTransacoes)),
    qtdTransacoes   = as.numeric(gsub(",", ".", qtdTransacoes))
  ) |>
  summarise(
    valorTransacoes = sum(valorTransacoes, na.rm = TRUE),
    qtdTransacoes   = sum(qtdTransacoes, na.rm = TRUE)
  )

base_est_meios_pgto <- df_cartoes |> 
  ungroup() |> 
  filter(funcaoCartao == "Crédito") |> 
  select(-segmento, -funcaoCartao) |>  
  group_by(trimestre, numeroparcelas) |>
  summarise(
    valorTransacoes = sum(valorTransacoes, na.rm = TRUE),
  ) |> 
  pivot_wider(names_from = numeroparcelas, values_from = valorTransacoes) |> 
  mutate(total =  `1 parcela` + `2 e 3 parcelas`+ `4 a 6 parcelas` + `7 ou + parcelas`) |> 
  mutate(`perc_1_parc` = `1 parcela`/total,
         `2 e 3 parc` = `2 e 3 parcelas`/3,
         `4 a 6 parc` = `4 a 6 parcelas`/3,
         `7 ou + parc` = `7 ou + parcelas`/3) |> 
  select(-total,-`1 parcela`, -`2 e 3 parcelas`, -`4 a 6 parcelas`, -`7 ou + parcelas` ) |> 
  rename(Trimestre = trimestre)|>
  mutate(
    ano = as.integer(substr(Trimestre, 1, 4)),
    tri = as.integer(substr(Trimestre, 5, 5)),
    data_tri = make_date(ano, (tri - 1) * 3 + 1, 1)
  )


