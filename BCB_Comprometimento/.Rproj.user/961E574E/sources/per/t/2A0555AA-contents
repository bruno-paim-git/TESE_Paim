####GET BCB DATA FUNCTION####

get_bcbdata_base <- function(cod_bcb){
  return(jsonlite::fromJSON(paste0("https://api.bcb.gov.br/dados/serie/bcdata.sgs.", cod_bcb,"/dados?formato=json")) |> 
           mutate(data = as.Date(data, format = "%d/%m/%Y"),
                  id = cod_bcb))}

dir.create("cache_bcb", showWarnings = FALSE)
dir.create("Output", showWarnings = FALSE)


get_bcbdata_cached <- function(cod_bcb, 
                               max_tentativas = 5, 
                               espera = 10,
                               usar_cache = TRUE) {
  
  arquivo_cache <- file.path("cache_bcb", paste0("bcb_", cod_bcb, ".rds"))
  
  # 1️⃣ Se existir cache, retorna direto
  if (usar_cache && file.exists(arquivo_cache)) {
    cat("📦 Lendo do cache:", cod_bcb, "\n")
    return(readRDS(arquivo_cache))
  }
  
  # 2️⃣ Caso contrário, tenta baixar
  safely_fun <- purrr::safely(get_bcbdata_base)
  
  for (i in 1:max_tentativas) {
    
    cat("🌐 Baixando código:", cod_bcb, 
        " | Tentativa:", i, "\n")
    
    res <- safely_fun(cod_bcb)
    
    if (is.null(res$error)) {
      
      # 💾 Salva no cache
      saveRDS(res$result, arquivo_cache)
      
      return(res$result)
    }
    
    if (i < max_tentativas) Sys.sleep(espera)
  }
  
  return(NULL)
}

