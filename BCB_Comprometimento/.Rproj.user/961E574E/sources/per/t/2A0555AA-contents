# atribui um valor médio para as faixas de parcelamento
df <- est_meios_pgto |>  
  pivot_longer(!c(Trimestre, data), names_to = "faixa") |> 
  mutate(prazo_medio = case_when(
    faixa == "2 e 3 parc" ~ 2.5,
    faixa == "4 a 6 parc" ~ 5,
    # faixa == "7 ou + parc" ~ 7
    data < "2016-01-01" & faixa == "7 ou + parc" ~ 8, # até 2016-01-01
    data >= "2016-01-01" & data < "2018-01-01" & faixa == "7 ou + parc" ~ 9, # até 2018-01-01
    data >= "2018-01-01" & data < "2024-01-01" & faixa == "7 ou + parc" ~ 10, # até 2024-01-01
    data >= "2024-01-01" & faixa == "7 ou + parc" ~ 11 # de 2024-01-01 em diante
  )) |> 
  filter(faixa != "perc_1_parc")

# Expande cada coorte em meses de vida
expand_coorte <- function(coorte_id, data, valor, prazo) {
  meses <- 0:(ceiling(prazo) - 1)
  tibble(
    coorte = coorte_id,
    data = data %m+% months(meses),
    valor_vivo = valor * (1 - meses / prazo), # linear amortização
    prazo_medio = prazo
  ) |> filter(valor_vivo > 0)
}

coortes_cc_sem_juros <- df %>%
  mutate(coorte_id = paste0("C", data)) %>%
  mutate(data = pmap(list(coorte_id, data, value, prazo_medio), expand_coorte)) %>%
  select(coorte_id, data, Trimestre) %>%
  unnest(data)

# Calcular estoque total e prazo médio mensal
serie_prazo <- coortes_cc_sem_juros %>%
  group_by(data) %>%
  summarise(
    valor_total = sum(valor_vivo),
    prazo_medio = sum(valor_vivo * prazo_medio) / sum(valor_vivo)
  )

