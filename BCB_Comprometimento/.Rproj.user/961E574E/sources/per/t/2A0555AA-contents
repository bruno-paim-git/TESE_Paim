# Função para converter o trimestre para os meses do trimestre
converter_trimestre_para_mes <- function(trimestre_str) {
  ano <- as.integer(str_sub(trimestre_str, 1, 4))
  trimestre <- as.integer(str_sub(trimestre_str, -1, -1))
  
  # Mapeia o trimestre para os meses
  meses_trimestre <- case_when(
    trimestre == 1 ~ c(1, 2, 3),  # 1º trimestre -> Janeiro, Fevereiro, Março
    trimestre == 2 ~ c(4, 5, 6),  # 2º trimestre -> Abril, Maio, Junho
    trimestre == 3 ~ c(7, 8, 9),  # 3º trimestre -> Julho, Agosto, Setembro
    trimestre == 4 ~ c(10, 11, 12)  # 4º trimestre -> Outubro, Novembro, Dezembro
  )
  
  # Cria as datas para os três meses do trimestre
  datas_meses <- as.Date(paste(ano, meses_trimestre, "01", sep = "-"))
  
  return(datas_meses)
}

# Aplicando a função para replicar os valores do trimestre para todos os meses
ajuste_tri <- lapply(base_est_meios_pgto$Trimestre, function(trimestre_str) {
  meses <- converter_trimestre_para_mes(trimestre_str)
  tibble(
    data = meses,
    valor_trimestre = rep(trimestre_str, length(meses))  # Replicando o valor do trimestre para todos os meses
  )
})


