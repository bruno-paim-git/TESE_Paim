grid_base_models <- tibble::tibble(
  nome_modelo = c("BUCCHIANICO_2024_a_BASELINE",
                  "BUCCHIANICO_2024_b_shock_i",
                  "BUCCHIANICO_2024_c_shock_phi0"),
  phi0_v = c(0.03, 0.03, 0.035),
  i_v    = c(0.01, 0.02, 0.01)
)


sfcr_scenarios_bucchianico <- function(nome_modelo, phi0_v, i_v,
                                       selected_equations = eqs_bucchianico2024,
                                       period_simulation = 100) {
  
  # --- parâmetros (Tabela 1) ---
  pi_v <- 0.39
  w_v <- 1 - pi_v
  cw_v <- 0.7
  cr_v <- 0.2
  ro_v <- 1
  un_v <- 0.8242
  v_v <- 0.989
  delta_v <- 0.084
  gamma_v <- 0.15
  phi1_v <- 0.1
  r_v <- 0.01
  
  # --- condições iniciais (Tabela 2) ---
  u_v  <- un_v
  h_v <- 0.148
  d0_v <- 0.049
  K_v <- 100
  gB_v  <- phi0_v - phi1_v*i_v +0.01           # 0.029 (equação)
  qc_v  <- cr_v*i_v - cw_v*(i_v + r_v)
  den   <- 1 - (cw_v*w_v + cr_v*ro_v*pi_v + h_v)
  
  # --- passado oculto (só para construir o t0) ---
  K0_v  <- K_v/(1 - delta_v + h_v*u_v/v_v)     # K(t-1)
  Yfc_v <- K0_v/v_v
  Y_v   <- u_v*Yfc_v                           # Y(t0)
  Lw0_v <- Y_v*den/(d0_v + qc_v)               # Lw(t-1): o mais antigo
  
  # --- estado em t0 ---
  Bw_v  <- d0_v*Lw0_v
  Lw_v  <- Bw_v + (1 - r_v)*Lw0_v
  Zw_v  <- Bw_v + qc_v*Lw0_v
  W_v = w_v*Y_v
  Ydw_v <- W_v - (r_v + i_v)*Lw0_v
  Ciw_v <- cw_v*Ydw_v
  Cw_v  <- Ciw_v + Bw_v
  Fb_v  <- i_v*Lw0_v
  FT_v  <- pi_v*Y_v
  FD_v  <- ro_v*FT_v
  Ydr_v <- FD_v + Fb_v
  Cr_v  <- cr_v*Ydr_v
  I_v   <- h_v*Y_v
  stopifnot(abs(Cw_v + Cr_v + I_v - Y_v) < 1e-6)
  
  Dw_v  <- 0
  Dr_v  <- Lw_v
  D_v   <- Lw_v
  E_v   <- K_v
  
  init_list <- list(
    Bw = Bw_v,
    Lw = Lw_v,
    gB = gB_v,
    d = d0_v,
    h = h_v,
    u = u_v,
    K = K_v,
    Yfc = Yfc_v, 
    Y = Y_v,
    I = I_v,
    W = W_v,
    Ydw = Ydw_v,
    Ciw = Ciw_v, 
    Cw = Cw_v, 
    Fb = Fb_v,
    FT = FT_v, 
    FD = FD_v, 
    FU = 0, 
    Ydr = Ydr_v,
    Cr = Cr_v,
    C = Cw_v + Cr_v,
    SAVw = Ydw_v - Cw_v,
    SAVr = Ydr_v - Cr_v - I_v,
    SAV = (Ydw_v - Cw_v) + (Ydr_v - Cr_v - I_v),
    E = E_v, 
    Dw = Dw_v,
    Dr = Dr_v,
    D = D_v, 
    Vw = Dw_v - Lw_v, 
    Vr = Dr_v + E_v
  )
  ext_list <- list(
    phi0 = phi0_v, 
    phi1 = phi1_v, 
    i = i_v,
    r = r_v, 
    cw = cw_v,
    cr = cr_v,
    pi = pi_v, 
    w = w_v, 
    gamma = gamma_v,
    ro = ro_v, 
    v = v_v,
    delta = delta_v,
    un = un_v
  )
  
  mk <- function(l) do.call(sfcr_set, lapply(names(l), function(n)
    as.formula(sprintf("%s ~ %.12g", n, l[[n]]))))
  
  sfcr_baseline(equations = selected_equations,
                external  = mk(ext_list),
                initial   = mk(init_list),
                periods   = period_simulation) |>
    dplyr::mutate(modelo = nome_modelo)
}


lista_modelos_baseline <- purrr::pmap(grid_base_models, sfcr_scenarios_bucchianico)
names(lista_modelos_baseline) <- grid_base_models$nome_modelo

