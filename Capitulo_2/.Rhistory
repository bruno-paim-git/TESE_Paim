d0_v
nome_modelo = "BUCCHIANICO_2024_a_BASELINE"
phi0_v = 0.03
i_v    = 0.01
# --- parâmetros (Tabela 1) ---
pi_v <- 0.39
w_v <- 1 - pi_v
cw_v <- 0.7
cr_v <- 0.2
ro_v <- 1
un_v <- 0.8242
v_v <- 0.989
delta_v <- 0.084
gamma_v <- 0.15
phi1_v <- 0.1
r_v <- 0.01
# --- condições iniciais (Tabela 2) ---
u_v  <- un_v
h_v <- 0.148
d0_v <- 0.049
K_v <- 100
gB_v  <- phi0_v - phi1_v*i_v +0.01           # 0.029 (equação)
qc_v  <- cr_v*i_v - cw_v*(i_v + r_v)
den   <- 1 - (cw_v*w_v + cr_v*ro_v*pi_v + h_v)
# --- passado oculto (só para construir o t0) ---
K0_v  <- K_v/(1 - delta_v + h_v*u_v/v_v)     # K(t-1)
Yfc_v <- K0_v/v_v
Y_v   <- u_v*Yfc_v                           # Y(t0)
Lw0_v <- Y_v*den/(d0_v + qc_v)               # Lw(t-1): o mais antigo
Lw0_v
Lw_v
# --- estado em t0 ---
Bw_v  <- d0_v*Lw0_v
Lw_v  <- Bw_v + (1 - r_v)*Lw0_v
Lw_v
View(lista_modelos_baseline[[1]] )
