font = list(size = 14)
)
}
plot_setterfield_eta_shock
# 1. Salvar o gráfico como HTML temporário
htmlwidgets::saveWidget(plot_setterfield_eta_shock, "temp_plot.html")
# 2. Capturar imagem a partir do HTML
webshot("temp_plot.html", file = paste0(".\\Output\\plot_setterfield_eta_shock.png"), vwidth = 1600, vheight = 800)
# 1. Dados
dados_plot <- multi_sk2016 %>%
bind_rows() %>%
pivot_longer(cols = -c(period, simulation)) %>%
filter(name == "dr")
# 2. Último ponto por simulação
ultimo_ponto <- dados_plot %>%
group_by(simulation) %>%
filter(period == max(period)) %>%
ungroup()
# 3. Labels personalizados
unique_sim <- sort(unique(dados_plot$simulation))
custom_labels <- as.character(sort(c(seq(4, 20, 4), 0.29, 2.92, 21.72)))
if (length(unique_sim) != length(custom_labels)) {
stop("Número de labels não corresponde ao número de simulações.")
}
label_map <- setNames(custom_labels, unique_sim)
# 4. Aplicar labels
dados_plot$sim_label <- label_map[as.character(dados_plot$simulation)]
ultimo_ponto$sim_label <- label_map[as.character(ultimo_ponto$simulation)]
# 5. Gráfico
plot_setterfield_eta_shock <- ggplot(dados_plot,
aes(x = period,
y = value,
group = simulation,
color = sim_label)) +
geom_line(size = 1) +
geom_hline(yintercept = 0)+
# Paleta equivalente ao Set1 do plotly
scale_color_brewer(palette = "Set1") +
# Anotações no último ponto
geom_text(data = ultimo_ponto,
aes(label = paste0("eta ", sim_label,
"\ndr = ", round(value, 3))),
hjust = -0.1,
size = 4) +
labs(
x = "Períodos",
y = "Razão Dívida/Estoque de Capital (dr)"
) +
theme_minimal(base_size = 16) +
theme(
legend.position = "none",   # remove legenda
axis.title = element_text(size = 18),
axis.text = element_text(size = 14),
plot.margin = margin(b = 40)
) +
# Espaço à direita para os labels
expand_limits(x = max(dados_plot$period) * 1.1)
plot_setterfield_eta_shock
ggsave(filename = paste0(".\\Output\\plot_setterfield_eta_shock_ggplot.svg"), plot = plot_setterfield_eta_shock, width = 16, height = 8, dpi = 800)
####MATRIZES####
#####BALANCE SHEET####
bs_SK2016 <- sfcr_matrix(
columns = c("Workers", "Rentiers", "Firms", "Banks", "Sum"),
codes = c("w", "r","f", "b", "s"),
c("Capital", f = "+K", s = "+K"),
c("Deposits", w = "+Dw", r = "+Dr", b = "-Dw-Dr"),
c("Loans", w = "-L", b = "+L"),
c("Equity", r = "+E", f ="-E"),
c("Net Worth", w = "+Dw-L", r = "+Dr+E", f = "+K-E", b = "+L -(Dw+Dr)", s ="+K"),
)
sfcr_matrix_display(bs_SK2016, "bs")
sfcr_validate(bs_SK2016, SK2016, "bs", rtol = TRUE,  tol = 1e-3)
#####TRANSACTION-FLOW####
tfm_SK2016 <- sfcr_matrix(
columns = c("Workers", "Rentiers", "Firms current", "Firms capital", "Banks current", "Banks capital"),
codes = c("w", "r", "fc", "fk", "bc", "bk"),
c("Consumption by wage", w = "-Cw", r = "-Cr", fc = "+Cw+Cr"),
c("Consumption by debt", w = "-(L - L[-1])", fc = "+(L - L[-1])"),
c("Investment", fc = "+I", fk = "-I"),
c("Wage", w = "Wp", r = "Wr", fc = "-W"),
c("Profits", r = "+PI", fc = "-PI"),
c("Deposit Interest", w = "+i*Dw", r = "+i*Dr", bc = "-i*(Dw+Dr)"),
c("Loan Interest", w = "-i*L", bc = "+i*L"),
c("Ch. Deposits", w = "-(Dw - Dw[-1])", r = "-(Dr - Dr[-1])", bk = "+(Dw - Dw[-1])+(Dr - Dr[-1])"),
c("Ch. Loans", w = "+(L-L[-1])", bk = "-(L-L[-1])"),
c("Issues of equities", r = "-(E-E[-1])", fk = "+(E-E[-1])"),
)
sfcr_matrix_display(tfm_SK2016)
sfcr_validate(tfm_SK2016, SK2016, which = "tfm", rtol = TRUE, tol = 1e-3)
sfcr_dag_blocks_plot(eqs)
sfcr_dag_cycles_plot(eqs, size = 10)
#####SANKEY'S DIAGRAM####
#carregar arquivo "funtion_sfcr_sankey.R"
sfcr_sankey(tfm_SK2016, SK2016, when = "start")
####BIBLIOTECA####
library(sfcr)
library(ggplot2)
library(tidyr)
library(dplyr)
library(plotly)
library(purrr)
library(tidyverse)
library(ggraph)
#####SISTEMA DE EQUAÇÕES - BUCCHIANICO 2024####
eqs_bucchianico2024 <- sfcr_set(
#####TRABALHADORES####
Ciw ~ cw * Ydw[-1],  #ATENÇÃO
# Ciw ~ cw * Ydw,  #ATENÇÃO
W ~ w*Y,
Ydw ~ W  - (r+i)*Lw[-1],
Bw ~ Bw[-1] + (phi0 - phi1*i)*Bw[-1],
Lw ~ Lw[-1] + Bw - r*Lw[-1],
Cw ~ Bw + Ciw,
Zw ~ Bw + (cr*i - cw*(i+r))*Lw[-1], #equação está errada no original
SAVw ~ Ydw - Cw ,
Dw ~ Dw[-1] + SAVw + Lw - Lw[-1] ,
######CAPITALISTAS####
Cr ~ cr*Ydr[-1],      #ATENÇÃO
# Cr ~ cr*Ydr,      #ATENÇÃO
Ydr ~ FD + Fb,
Fb ~ i*Lw[-1],
FT ~ pi*Y,
FD ~ ro*FT,
SAVr ~ Ydr - Cr - (E - E[-1]),
Dr ~ Dr[-1] + SAVr,
######EMPRESAS####
I ~ h*Y[-1],   #ATENÇÃO
# I ~ h*Y,   #ATENÇÃO
h ~ h[-1] + h[-1]*gamma*(u[-1] - un),   #ATENÇÃO
# h ~ h[-1] + h[-1]*gamma*(u - un),   #ATENÇÃO
K ~ K[-1] + I - delta*K[-1],
FU ~ (1-ro)*FT,
E ~ I + E[-1],
######ATIVIDADE####
u ~ Y/Yfc,
Yfc ~ K/v,
######FECHAMENTO####
C ~ Cw + Cr,
Y ~ C + I,
D ~ Dw + Dr,
SAV ~ SAVw + SAVr,
# gZw ~ Zw/Zw[-1] -1,
# #FOR BALANCE-SHEET MATRIX
Vw ~ Dw - Lw,
Vr ~ Dr + E, #alterado
#FOR TRANSACTION-FLOW MATRIX
d ~ Bw/Lw
)
grid_base_models <- tibble::tibble(
nome_modelo = c("BUCCHIANICO_2024_a_BASELINE", "BUCCHIANICO_2024_b_schock_i", "BUCCHIANICO_2024_c_schock_phi0"),
phi0_v = c(0.03,   0.03,   0.035),
i_v =    c(0.01,   0.02,   0.01),
Lw_v =   c(824 ,   924,    824))
sfcr_scenarios_bucchianico <- function(nome_modelo, phi0_v, i_v, Lw_v, selected_equations = eqs_bucchianico2024, period_simulation = 100){
phi0_v = phi0_v
i_v = i_v
Lw_v = Lw_v
# phi0_v = 0.03
# i_v = 0.01
# Lw_v = 824
pi_v = 0.39
cw_v = 0.7
cr_v = 0.2
un_v = 0.8242
v_v = 0.989
delta_v = 0.084
gamma_v = 0.15
phi1_v = 0.1 #Sensitivity of credit-financed consumption to i
r_v = 0.01 # Amortisation rate
w_v = 1 - pi_v
ro_v = 1
u_v = 0.8242
d_v = 0.049 #credit financed consumptio to debt rate
gZw_v = 0.039
h_v = 0.148
K_v = 100
Dw_v = 0
Dr_v = 0
D_v = 0
Bw_v = d_v*Lw_v
Zw_v = Bw_v + (cr_v*i_v - cw_v*(i_v+r_v))*Lw_v
#### PARÂMETROS DEFINIDOS A PARTIR DAS EQUAÇÕES ####
Yfc_v = K_v/v_v
Y_v = Yfc_v*un_v
FT_v = pi_v*Y_v
FD_v = ro_v*FT_v
Fb_v = i_v*Lw_v
Cr_v = cr_v*(FD_v + Fb_v)
W_v = w_v*Y_v
Ydw_v = W_v - (r_v+i_v)*Lw_v
Ciw_v = cw_v * Ydw_v
Cw_v = Ciw_v + Bw_v
FU_v = 0
I_v = h_v*Y_v # - delta_v*K_v
E_v = I_v
Ydr_v = FD_v + Fb_v
C_v = Cw_v + Cr_v
Ycalc_v = Cw_v + Cr_v + I_v
SAVw_v = Ydw_v - Cw_v
SAVr_v = FD_v + Fb_v - Cr_v
SAV_v = SAVw_v + SAVr_v + FU_v
Vr_v = SAVr_v + E_v
####VALORS INICIAIS####
parametros_iniciais <- list(
E = E_v,
Vr = Vr_v,
phi0 = phi0_v,
phi1 = phi1_v,
i = i_v,
r = r_v,
cw = cw_v,
cr = cr_v,
pi = pi_v,
w = w_v,
gamma = gamma_v,
ro =ro_v,
v = v_v,
delta = delta_v,
u = u_v,
un = un_v,
h = h_v,
Dw = Dw_v,
Dr = Dr_v,
D = D_v,
Lw = Lw_v,
K = K_v,
Zw = Zw_v,
Yfc = Yfc_v,
Y = Ycalc_v,
C = C_v,
Ciw = Ciw_v,
Cw = Cw_v,
Ydw = Ydw_v,
SAVw = SAVw_v,
Cr = Cr_v,
SAVr = SAVr_v,
Fb = Fb_v,
FT = FT_v,
FU = FU_v,
FD = FD_v,
SAV = SAV_v,
I = h_v*Y_v,
Bw = Bw_v,
# gZw = gZw_v,
W = W_v,
Ydr = Ydr_v
)
# Transforma em lista de fórmulas
lista_formula_iniciais <- lapply(names(parametros_iniciais), function(nome) {
as.formula(paste0(nome, " ~ ", parametros_iniciais[[nome]]))
})
# Chama sfcr_set via do.call
init <- do.call(sfcr_set, lista_formula_iniciais)
####VALORS EXTERNOS####
# Lista nomeada de parâmetros
parametros_externos <- list(
phi0 = phi0_v,
phi1 = phi1_v,
i = i_v,
r = r_v,
cw = cw_v,
cr = cr_v,
pi = pi_v,
w = w_v,
gamma = gamma_v,
ro = ro_v,
v = v_v,
delta = delta_v,
un = un_v
)
# Transforma em lista de fórmulas
lista_formula_externos <- lapply(names(parametros_externos), function(nome) {
as.formula(paste0(nome, " ~ ", parametros_externos[[nome]]))
})
# Chama sfcr_set via do.call
ext <- do.call(sfcr_set, lista_formula_externos)
print(nome_modelo)
sim_model <- sfcr_baseline(
equations = selected_equations,
external  = ext,
initial   = init,
periods   = period_simulation
# hidden = c("Y" = "Yd")
# hidden = NULL
)
df_simulation <- sim_model |>
mutate(
modelo = nome_modelo
)
return(df_simulation
)
}
lista_modelos_baseline <- purrr::pmap(grid_base_models, sfcr_scenarios_bucchianico)
names(lista_modelos_baseline) <- grid_base_models$nome_modelo
####função para adicionar variáveis de análise nos modelos simulados
process_model_df <- function(df_model) {
df_model |>
mutate(
#serviço da dívida
dsw_y = ((r+i)*Lw)/(w*Y),
#consumo em relação ao estoque de capital
cw_k= Cw/lag(K),
cr_k= Cr/lag(K),
#consumo em relação à renda
cw_y= Cw/Y,
cr_y= Cr/Y,
bw_y = Bw/Y,
#nível de consumo
log_Cw = log(Cw),
#dívida em relação ao estoque de capital
lw= Lw/K,
#nível da renda
log_y = log(Y),
log_ydw = log(Ydw),
gY = Y/lag(Y) -1,
#patrimônio Líquido
Vw_y = Vw/Y,
Vr_y = Vr/Y,
# SAVr_Y = SAVr/Y,
Zw_y = Zw/Y,
d = Bw/Lw,
#estabilidade keynesiana
# est_key = if ( (1- cr_v*ro_v*pi_v -cw_v*w_v) > h_v) {1} else {0}
)|>
pivot_longer(cols = -any_of(c("period", "modelo")))
}
df_scenario1_TOTAL <- map_df(lista_modelos_baseline, process_model_df)
list_modelos <- grid_base_models$nome_modelo
vars <- c("h","d", "u")
df_plot <-
df_scenario1_TOTAL %>%
dplyr::filter(name %in% vars, period <= 100)
df_plot$modelo <- factor(df_plot$modelo, levels = list_modelos)
df_plot$name <- factor(df_plot$name, levels = vars)
labels_modelos <- c(
"BUCCHIANICO_2024_a_BASELINE"   = "Base",
"BUCCHIANICO_2024_b_schock_i"    = "Choque na taxa de juros (i)",
"BUCCHIANICO_2024_c_schock_phi0" = "Choque no componente autônomo (φ0)"
)
plot_simulation_bucchianico <-ggplot(df_plot, aes(x = period, y = value)) +
geom_line(
aes(
linetype = modelo,
color = modelo
),
linewidth = 1
) +
labs(
x = "Horizonte",
y = ""
) +
theme_bw(base_size = 16) + # Tema de fundo branco
theme(
text = element_text(size = 18),       # aumenta todas as fontes
axis.title = element_text(size = 18), # títulos dos eixos
axis.text = element_text(size = 16),  # valores dos eixos
legend.text = element_text(size = 20),
panel.grid.minor = element_line(color = "grey90"),          # remove grades menores
panel.grid.major.x = element_line(color = "grey90"),   # mantém apenas a grade principal em x
panel.grid.major.y = element_line(color = "grey90"),
panel.background = element_rect(fill = "white", color = "white"),  # Fundo branco no painel
plot.background = element_rect(fill = "white", color = "white"),  # Fundo branco no gráfico
legend.position = "bottom",
legend.title = element_blank())+
facet_wrap(~ name, scales = "free_y") +
scale_linetype_manual(
values = setNames(
c("solid", "dashed", "dashed"),
list_modelos
),
labels = labels_modelos
) +
scale_color_manual(
values = setNames(
c("black",  "orange3", "green4"),
list_modelos
),
labels = labels_modelos
)+
theme(strip.text = element_text(size = 12))
plot_simulation_bucchianico
ggsave(filename = file.path("Output", paste0("plot_simulation_bucchianico", "_ggplot.png")), plot = plot_simulation_bucchianico,
width = 12, height = 4, dpi = 800 )
ggsave(filename = file.path("Output", paste0("plot_simulation_bucchianico", ".svg")), plot = plot_simulation_bucchianico,
width = 12, height = 4, dpi = 800 )
