codes = c("w", "r", "f", "b", "s"),
c("Capital", f = "+K", s ="+K"),
c("Deposits", w = "+Dw", r = "+Dr", b = "-D"),
c("Loans", w = "-Lw", b = "+Lw"),
c("Equities", r = "+E", f = "-E"),
c("Net Worth", w = "Vw", r = "Vr", f = "+K-E", b = "Lw - D",s ="+K")
)
